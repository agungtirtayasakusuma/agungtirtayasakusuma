---
// src/layouts/BlogPost.astro
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, type } = post.data;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={`${title} — арговеста.notes`} description={description}>
  <article class="mx-auto max-w-2xl">
    <a href="/blog" class="meta text-muted no-underline transition-colors hover:text-accent">← journal</a>

    <header class="mt-8 border-b border-border pb-8">
      <div class="meta flex flex-wrap items-center gap-2.5 text-muted">
        <time>{fmt(pubDate)}</time>
        {type === 'log' && (
          <span class="rounded-md border border-green/35 bg-green/10 px-1.5 py-px text-green">log</span>
        )}
        {updatedDate && <span>· updated {fmt(updatedDate)}</span>}
      </div>
      <h1 class="mt-4 text-3xl font-semibold leading-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-muted">{description}</p>
      {tags.length > 0 && <div class="mt-5 flex flex-wrap gap-1.5">{tags.map((t) => <Tag label={t} />)}</div>}
    </header>

    <div class="prose mt-10"><slot /></div>
  </article>
</BaseLayout>
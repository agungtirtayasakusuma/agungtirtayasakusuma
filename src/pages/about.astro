---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
import { experience } from '../data/experience';
import { certificates } from '../data/certificates';

const skillCategories = [
  {
    label: 'routing & switching',
    items: [
      { name: 'OSPF', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
      { name: 'Static Routing', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
      { name: 'VLANs', icon: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4' },
      { name: 'Inter-VLAN Routing', icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' },
      { name: 'STP', icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15' },
      { name: 'EtherChannel', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
      { name: 'HSRP', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
    ]
  },
  {
    label: 'services & security',
    items: [
      { name: 'NAT', icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' },
      { name: 'DHCP', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
      { name: 'Firewall Filter', icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z' },
      { name: 'QoS', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
      { name: 'GRE Tunnel', icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' }
    ]
  },
  {
    label: 'platforms & practice',
    items: [
      { name: 'Cisco IOS', icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
      { name: 'MikroTik RouterOS', icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01' },
      { name: 'Packet Tracer', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
      { name: 'CCNA', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' },
      { name: 'IT Support', icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636l3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z' }
    ]
  }
];

const groupedMap: Record<string, { company: string; location?: string; roles: typeof experience }> = {};
experience.forEach((job) => {
  if (!groupedMap[job.company]) {
    groupedMap[job.company] = {
      company: job.company,
      location: job.location,
      roles: []
    };
  }
  groupedMap[job.company].roles.push(job);
});
const companyList = Object.values(groupedMap);
---

<BaseLayout title={`About`}>
  <div class="mx-auto max-w-3xl py-6">
    <!-- Header -->
    <div>
      <p class="meta uppercase tracking-widest text-green">Profile</p>
      <h1 class="mt-1 text-3xl font-semibold">{site.author}</h1>
      <p class="mt-1 text-sm text-muted">{site.role}</p>
    </div>

    <!-- Bio -->
    <div class="mt-8 space-y-4 leading-relaxed text-fg">
      <p>
        My experience focuses on managing and supporting MikroTik RouterOS in a production
        environment to maintain reliable network connectivity and business operations. My
        responsibilities include LAN and wireless connectivity, NAT, DHCP, Firewall Filter,
        Quality of Service (QoS), and troubleshooting network issues.
      </p>
      <p>
        To strengthen my networking foundation, I'm continuously sharpening my Cisco networking
        skills through CCNA training and hands-on Packet Tracer labs covering VLAN, Inter-VLAN
        Routing, STP, EtherChannel, HSRP, Static Routing, NAT, and GRE Tunnel.
      </p>
      <p>
        I'm committed to continuous learning and preparing for opportunities in Network
        Engineering by combining production experience with hands-on Cisco networking practice.
      </p>
    </div>

    <!-- Skills -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold">Skills</h2>
      <div class="mt-6 space-y-4">
        {skillCategories.map(({ label, items }) => (
          <div class="card p-5">
            <p class="meta uppercase tracking-wide text-muted mb-3">{label}</p>
            <div class="flex flex-wrap gap-2">
              {items.map(({ name, icon }) => (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3.5 py-1.5 text-xs font-mono font-medium text-fg shadow-sm transition-colors hover:border-accent hover:bg-surface-2">
                  <svg class="h-3.5 w-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
                  </svg>
                  {name}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold">Experience</h2>
      <div class="mt-6 space-y-6">
        {companyList.map((comp) => (
          <div class="card p-6 space-y-6">
            <div class="flex items-center gap-4 pb-4 border-b border-border">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-border bg-surface">
                <img
                  src="/avenir.jpg"
                  alt={comp.company}
                  class="h-full w-full object-cover"
                />
              </div>
              <div>
                <h3 class="text-lg font-semibold text-heading">{comp.company}</h3>
                <p class="meta mt-0.5 text-muted">
                  Total: <span class="text-fg font-medium">4 thn</span> · {comp.location}
                </p>
              </div>
            </div>

            <div class="space-y-8">
              {comp.roles.map((job, idx) => (
                <div class={`${idx !== 0 ? 'pt-6 border-t border-border/40' : ''}`}>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <h4 class="text-base font-semibold text-heading">{job.role}</h4>
                    <p class="meta shrink-0 text-muted">
                      {job.start} – {job.end} · <span class="text-fg font-medium">{job.duration}</span>
                    </p>
                  </div>
                  <p class="meta mt-0.5 text-accent">{job.type}</p>

                  <ul class="mt-3 space-y-2">
                    {job.highlights.map((h) => (
                      <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                        <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-muted/60"></span>
                        <span class="text-fg">{h}</span>
                      </li>
                    ))}
                  </ul>

                  {job.skills && job.skills.length > 0 && (
                    <div class="mt-4 pt-3 border-t border-border/30 flex flex-wrap items-center gap-1.5">
                      <span class="text-xs font-semibold text-muted mr-1">Skills:</span>
                      {job.skills.map((s) => (
                        <span class="rounded border border-border/80 bg-surface/60 px-2 py-0.5 text-[11px] font-medium text-muted hover:text-fg transition-colors">
                          {s}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Licenses & Certifications -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold">Licenses & Certifications</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {certificates.map((cert, index) => {
          const issuerLower = cert.issuer.toLowerCase();
          let logoPath = '';
          if (issuerLower.includes('id-networkers')) logoPath = '/idn.jpg';
          else if (issuerLower.includes('packt')) logoPath = '/packt.jpg';
          else if (issuerLower.includes('google')) logoPath = '/google.jpg';

          const skillsList = cert.skills || [];
          const hasMore = skillsList.length > 3;
          const firstSkills = skillsList.slice(0, 3).join(', ');
          const remainingSkills = skillsList.slice(3).join(', ');

          return (
            <div class="card flex flex-col p-5">
              <div class="flex items-start gap-3.5">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-md border border-border bg-surface">
                  {logoPath ? (
                    <img src={logoPath} alt={cert.issuer} class="h-full w-full object-cover" />
                  ) : (
                    <span class="font-mono text-sm font-bold text-heading">{cert.issuer.charAt(0)}</span>
                  )}
                </div>
                <div>
                  <h3 class="text-base font-semibold leading-snug text-heading">{cert.name}</h3>
                  <p class="mt-0.5 text-sm text-muted">{cert.issuer}</p>
                </div>
              </div>

              <div class="mt-4 space-y-1.5 text-sm text-muted">
                <p class="meta">Issued {cert.issued}{cert.expires && <> · Expires {cert.expires}</>}</p>
                {cert.credentialId && <p class="meta">Credential ID {cert.credentialId}</p>}
                
                {skillsList.length > 0 && (
                  <div class="mt-4 pt-3 border-t border-border/30 text-xs text-muted">
                    <span class="font-semibold text-fg/90">Skills: </span>
                    <span>
                      {firstSkills}
                      {hasMore && (
                        <>
                          {' and '}
                          <button
                            type="button"
                            class="toggle-skills-btn text-accent font-medium hover:underline cursor-pointer focus:outline-none"
                            data-target={`skills-more-${index}`}
                          >
                            +{skillsList.length - 3} skills
                          </button>
                        </>
                      )}
                    </span>
                    {hasMore && (
                      <div id={`skills-more-${index}`} class="hidden mt-1 text-muted/90 text-xs leading-relaxed">
                        {remainingSkills}
                      </div>
                    )}
                  </div>
                )}
              </div>

              {cert.url && cert.url.trim() !== '' && (
                <div class="mt-5 pt-4 border-t border-border mt-auto">
                  <a
                    href={cert.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="relative z-10 inline-flex items-center gap-1.5 rounded-md border border-border bg-surface px-3.5 py-1.5 text-xs font-medium text-fg no-underline transition-colors hover:border-accent hover:bg-surface-2 cursor-pointer"
                  >
                    Show credential 
                    <span class="text-accent">↗</span>
                  </a>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function initSkillsToggle() {
    const buttons = document.querySelectorAll('.toggle-skills-btn');
    buttons.forEach((btn) => {
      if (btn instanceof HTMLButtonElement) {
        const originalText = btn.textContent || '';
        if (!btn.hasAttribute('data-original-text')) {
          btn.setAttribute('data-original-text', originalText);
        }

        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          if (!targetId) return;
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            const isHidden = targetEl.classList.contains('hidden');
            if (isHidden) {
              targetEl.classList.remove('hidden');
              btn.textContent = '(tutup)';
            } else {
              targetEl.classList.add('hidden');
              btn.textContent = btn.getAttribute('data-original-text') || originalText;
            }
          }
        });
      }
    });
  }

  // Jalankan saat pertama load dan saat navigasi ClientRouter Astro
  initSkillsToggle();
  document.addEventListener('astro:page-load', initSkillsToggle);
</script>
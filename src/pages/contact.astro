---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, contact, socials } from '../config';

const getSocialIcon = (label: string) => {
  switch (label.toLowerCase()) {
    case 'github':
      return 'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4M9 18c-4.51 2-5-2-7-2';
    case 'linkedin':
      return 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 0 2 2 2 2 0 0 0-2-2z';
    case 'instagram':
      return 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm6.5-.75a1.25 1.25 0 1 0-2.5 0 1.25 1.25 0 0 0 2.5 0z';
    case 'x':
    case 'twitter':
      return 'M4 4l11.733 16h4.267l-11.733 -16zM4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772';
    default:
      return 'M5 12h14m-7-7l7 7-7 7';
  }
};
---

<BaseLayout title={`Contact | ${site.title}`} description="Get in touch for network engineering inquiries or project discussions.">
  <div class="mx-auto max-w-2xl py-6">
    <p class="meta uppercase tracking-widest text-green">GET IN TOUCH</p>
    <h1 class="mt-2 text-3xl font-semibold">Contact</h1>
    <p class="mt-3 text-muted">
      Have a question, feedback, or opportunity to discuss? Feel free to get in touch.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-10 md:grid-cols-2">
      <!-- Direct Contact Info -->
      <div class="space-y-6">
        <div>
          <p class="meta text-muted">EMAIL</p>
          <a href={`mailto:${contact.email}`} class="text-sm font-medium text-accent hover:underline mt-1 block">
            {contact.email}
          </a>
        </div>

        <div>
          <p class="meta text-muted">LOCATION</p>
          <p class="text-sm text-fg mt-1">{contact.location}</p>
        </div>

        <div>
          <p class="meta text-muted">SOCIALS</p>
          <ul class="mt-2 space-y-2 text-sm">
            {socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-accent hover:underline"
                >
                  <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d={getSocialIcon(s.label)}></path>
                  </svg>
                  <span>{s.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Form Component -->
      <div>
        <ContactForm />
      </div>
    </div>
  </div>
</BaseLayout>
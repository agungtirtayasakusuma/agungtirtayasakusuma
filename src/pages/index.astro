---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import Button from '../components/Button.astro';
import { site } from '../config';
import { getCollection } from 'astro:content';
import avatarImg from '../assets/avatar.png';

const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
---

<BaseLayout title={`${site.title} | ${site.author}`}>
  <section class="py-10 sm:py-16">
    <div class="flex flex-col items-start gap-10 md:flex-row md:items-center">
      <img
        src={avatarImg.src}
        width={avatarImg.width}
        height={avatarImg.height}
        alt={site.author}
        class="pixelated h-32 w-32 shrink-0 rounded-xl border border-border bg-surface shadow-lg shadow-black/30 sm:h-36 sm:w-36"
      />

      <div>
        <p class="meta uppercase tracking-widest text-green">{site.role}</p>
        <h1 class="mt-3 max-w-2xl text-3xl font-semibold leading-tight sm:text-4xl">
  		 Building <span class="text-accent">reliable </span>
		 <br>
		 network infrastructure
		</h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">
          Cisco labs, networking projects, and technical documentation focused on routing, switching, network services, and network security.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href="/projects">View Projects</Button>
          <Button href={site.cv} variant="ghost" download>Download CV</Button>
        </div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="mt-16">
      <div class="flex items-baseline justify-between">
        <h2 class="text-xl font-semibold">Featured Projects</h2>
        <a href="/projects" class="meta text-muted no-underline transition-colors hover:text-accent">all →</a>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="mt-16">
      <div class="flex items-baseline justify-between">
        <h2 class="text-xl font-semibold">Latest Articles</h2>
        <a href="/blog" class="meta text-muted no-underline transition-colors hover:text-accent">all →</a>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {recentPosts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>
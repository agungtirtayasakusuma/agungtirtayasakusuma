---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import Button from '../components/Button.astro';
import { site } from '../config';
import { getCollection } from 'astro:content';
import avatarImg from '../assets/avatar.png';

const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
---

<BaseLayout title={`${site.title} | ${site.author}`}>
  <section class="py-10 sm:py-16">
    <!-- Ubah md:items-center menjadi md:items-start agar sejajar secara profesional dari atas -->
    <div class="flex flex-col items-start gap-10 md:flex-row md:items-start">
      
      <!-- Bungkus utama dikunci ukurannya agar proporsional dan tidak terlalu besar -->
      <div class="flex flex-col shrink-0 w-36 sm:w-44 gap-3">
        
        <!-- Jendela Terminal Mengikuti Lebar Foto -->
        <div class="w-full font-mono text-[10px] bg-black/90 border border-border rounded-lg shadow-xl overflow-hidden">
          <!-- Header Tombol Titik (Merah, Kuning, Hijau) -->
          <div class="flex items-center gap-1.5 px-2 py-1.5 bg-surface/50 border-b border-border">
            <div class="w-2 h-2 rounded-full bg-red-500"></div>
            <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
            <div class="w-2 h-2 rounded-full bg-green-500"></div>
          </div>
          <!-- Isi Teks Terminal (Terpotong rapi jika kepanjangan) -->
          <div class="px-2.5 py-1.5 text-left truncate">
            <span style="color: #3fb950;" class="font-semibold"># {site.author}</span>
          </div>
        </div>

        <!-- Foto Profil dengan ukuran proporsional -->
        <img
          src={avatarImg.src}
          width={avatarImg.width}
          height={avatarImg.height}
          alt={site.author}
          class="pixelated w-full h-auto aspect-square rounded-xl border border-border bg-surface shadow-lg shadow-black/30 object-cover"
        />
        
      </div>
      <div>
        <p class="meta uppercase tracking-widest text-green">{site.role}</p>
        <h1 class="mt-3 max-w-2xl text-3xl font-semibold leading-tight sm:text-4xl">
          Building <span class="text-accent">reliable </span>
          <br>
          network infrastructure
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">
          Cisco labs, networking projects, and technical documentation focused on routing, switching, network services, and network security.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href="/projects">View Projects</Button>
          <Button href={site.cv} variant="ghost" download>Download CV</Button>
        </div>
      </div>
    </div>
  </section>
  {featured.length > 0 && (
    <section class="mt-16">
      <div class="flex items-baseline justify-between">
        <h2 class="text-xl font-semibold">Featured Projects</h2>
        <a href="/projects" class="meta text-muted no-underline transition-colors hover:text-accent">all →</a>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="mt-16">
      <div class="flex items-baseline justify-between">
        <h2 class="text-xl font-semibold">Latest Articles</h2>
        <a href="/blog" class="meta text-muted no-underline transition-colors hover:text-accent">all →</a>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {recentPosts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>
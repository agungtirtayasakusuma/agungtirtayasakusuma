---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import Button from '../components/Button.astro';
import { site } from '../config';
import { getCollection } from 'astro:content';
import avatarImg from '../assets/avatar.png';

const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout title={`${site.title} | ${site.author}`}>
  <!-- ── Hero ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-14">
      <!-- Rail: stacked identity card. Sticks only on desktop. -->
      <aside class="rail-sticky">
        <div class="flex items-center gap-4 sm:gap-5 lg:block">
          <img
            src={avatarImg.src}
            width={avatarImg.width}
            height={avatarImg.height}
            alt={site.author}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="pixelated aspect-square w-24 shrink-0 rounded-xl border border-border bg-surface object-cover shadow-lg shadow-black/30 sm:w-28 lg:w-full"
          />

          <div class="term min-w-0 flex-1 lg:mt-4 lg:w-full">
            <div class="term-bar">
              <span class="term-dot" style="background:#f85149"></span>
              <span class="term-dot" style="background:#d29922"></span>
              <span class="term-dot" style="background:#3fb950"></span>
            </div>
            <div class="term-body">
              <p class="truncate">
                <span class="text-muted">$</span> whoami
              </p>
              <p class="truncate font-semibold text-green">{site.author}</p>
              <p class="mt-1.5 truncate">
                <span class="text-muted">$</span> show role
              </p>
              <p class="truncate text-fg">
                {site.role}<span class="caret" aria-hidden="true">▌</span>
              </p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Headline column -->
      <div class="min-w-0">
        <p class="meta uppercase tracking-widest text-green">{site.role}</p>

        <h1 class="t-display mt-3 max-w-[22ch] font-semibold">
          Building <span class="text-accent">reliable</span> network infrastructure
        </h1>

        <p class="t-lead mt-5 max-w-[60ch] text-muted">
          Cisco labs, networking projects, and technical documentation focused on routing,
          switching, network services, and network security.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/projects">View projects</Button>
          <Button href={site.cv} variant="ghost" download>Download CV</Button>
        </div>

        <!-- Quiet credibility strip. Wraps cleanly at every width. -->
        <dl class="mt-9 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-3">
          <div class="bg-surface px-4 py-3">
            <dt class="meta text-muted">Focus</dt>
            <dd class="mt-1 text-sm text-fg">Routing &amp; switching</dd>
          </div>
          <div class="bg-surface px-4 py-3">
            <dt class="meta text-muted">Platforms</dt>
            <dd class="mt-1 text-sm text-fg">Cisco IOS · MikroTik</dd>
          </div>
          <div class="col-span-2 bg-surface px-4 py-3 sm:col-span-1">
            <dt class="meta text-muted">Based in</dt>
            <dd class="mt-1 text-sm text-fg">Bekasi, Indonesia</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ── Featured projects ──────────────────────────────────────── -->
  {featured.length > 0 && (
    <section class="section">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="t-h2 font-semibold">Featured projects</h2>
        <a href="/projects" class="meta shrink-0 text-muted no-underline transition-colors hover:text-accent">
          all →
        </a>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}

  <!-- ── Latest articles ────────────────────────────────────────── -->
  {recentPosts.length > 0 && (
    <section class="section">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="t-h2 font-semibold">Latest articles</h2>
        <a href="/blog" class="meta shrink-0 text-muted no-underline transition-colors hover:text-accent">
          all →
        </a>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {recentPosts.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .caret {
    margin-left: 1px;
    color: var(--color-green);
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
  }
</style>

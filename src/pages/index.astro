---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.astro';
import InterfaceMenu from '../components/InterfaceMenu.astro';
import ExperienceList from '../components/ExperienceList.astro';
import CertificateList from '../components/CertificateList.astro';
import { site, contact, socials } from '../config';
import { getCollection } from 'astro:content';
import avatarImg from '../assets/avatar.png';

const allProjects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Featured first, then the rest. Nothing is dropped — the archive links below
// only appear when the cap actually hides something.
const PROJECT_CAP = 6;
const POST_CAP = 6;

const projects = [
  ...allProjects.filter((p) => p.data.featured),
  ...allProjects.filter((p) => !p.data.featured),
].slice(0, PROJECT_CAP);

const posts = allPosts.slice(0, POST_CAP);

const skillGroups = [
  {
    label: 'routing & switching',
    items: ['OSPF', 'Static Routing', 'VLANs', 'Inter-VLAN Routing', 'STP', 'EtherChannel', 'HSRP'],
  },
  {
    label: 'services & security',
    items: ['NAT', 'DHCP', 'Firewall Filter', 'QoS', 'GRE Tunnel'],
  },
  {
    label: 'platforms & practice',
    items: ['Cisco IOS', 'MikroTik RouterOS', 'Packet Tracer', 'CCNA', 'IT Support'],
  },
];
---

<BaseLayout title={`${site.author} — ${site.role}`}>
  <div class="page-grid">
    <!-- ══ Left column: identity rail (sticky on desktop) ══════════ -->
    <aside class="rail-col">
      <div class="rail-sticky">
        <div class="rail-id">
          <img
            src={avatarImg.src}
            width={avatarImg.width}
            height={avatarImg.height}
            alt={site.author}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="rail-avatar pixelated"
          />

          <div class="term rail-term">
            <div class="term-bar">
              <span class="term-dot" style="background:#f85149"></span>
              <span class="term-dot" style="background:#d29922"></span>
              <span class="term-dot" style="background:#3fb950"></span>
            </div>
            <div class="term-body">
              <p class="truncate"><span class="text-muted">$</span> whoami</p>
              <p class="truncate font-semibold text-green">{site.author}</p>
              <p class="mt-1.5 truncate"><span class="text-muted">$</span> show role</p>
              <p class="truncate text-fg">
                {site.role}<span class="caret" aria-hidden="true">▌</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Scroll-spy menu. Desktop only — the top nav covers small screens. -->
        <div class="hidden lg:block">
          <InterfaceMenu />
        </div>

        <ul class="mt-5 hidden flex-wrap gap-x-4 gap-y-1.5 lg:flex">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="meta text-muted no-underline transition-colors hover:text-accent"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <!-- ══ Right column: stacked sections ══════════════════════════ -->
    <div class="min-w-0">
      <!-- ── f0/1 · Home ────────────────────────────────────────── -->
      <section id="home" data-section data-iface="1" class="sec sec-first">
        <p class="meta uppercase tracking-widest text-green">{site.role}</p>

        <h1 class="t-display mt-3 max-w-[22ch] font-semibold">
          Building <span class="text-accent">reliable</span> network infrastructure
        </h1>

        <p class="t-lead mt-5 max-w-[60ch] text-muted">
          Cisco labs, networking projects, and technical documentation focused on routing,
          switching, network services, and network security.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/#projects">View projects</Button>
          <Button href={site.cv} variant="ghost" download>Download CV</Button>
        </div>

        <dl class="stat-strip mt-9">
          <div class="stat-cell">
            <dt class="meta text-muted">Focus</dt>
            <dd class="mt-1 text-sm text-fg">Routing &amp; switching</dd>
          </div>
          <div class="stat-cell">
            <dt class="meta text-muted">Platforms</dt>
            <dd class="mt-1 text-sm text-fg">Cisco IOS · MikroTik</dd>
          </div>
          <div class="stat-cell stat-cell-wide">
            <dt class="meta text-muted">Based in</dt>
            <dd class="mt-1 text-sm text-fg">Bekasi, Indonesia</dd>
          </div>
        </dl>
      </section>

      <!-- ── f0/2 · Projects ────────────────────────────────────── -->
      <section id="projects" data-section data-iface="2" class="sec">
        <header class="sec-head">
          <p class="meta text-green">interface FastEthernet0/2</p>
          <h2 class="t-h2 mt-1.5 font-semibold">Projects</h2>
          <p class="t-lead mt-3 text-muted">
            Cisco labs, networking projects, and production-inspired implementations — each
            with its topology, configuration, and downloadable Packet Tracer file.
          </p>
        </header>

        {projects.length > 0 ? (
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {projects.map((p) => <ProjectCard project={p} />)}
          </div>
        ) : (
          <p class="mt-8 text-sm text-muted">No published labs yet.</p>
        )}

        {allProjects.length > projects.length && (
          <a href="/projects" class="sec-more">
            View all {allProjects.length} labs <span aria-hidden="true">→</span>
          </a>
        )}
      </section>

      <!-- ── f0/3 · Journal ─────────────────────────────────────── -->
      <section id="journal" data-section data-iface="3" class="sec">
        <header class="sec-head">
          <p class="meta text-green">interface FastEthernet0/3</p>
          <h2 class="t-h2 mt-1.5 font-semibold">Journal</h2>
          <p class="t-lead mt-3 text-muted">
            Technical notes, implementation guides, and lessons learned from networking labs
            and real-world troubleshooting.
          </p>
        </header>

        {posts.length > 0 ? (
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {posts.map((p) => <PostCard post={p} />)}
          </div>
        ) : (
          <p class="mt-8 text-sm text-muted">No published notes yet.</p>
        )}

        {allPosts.length > posts.length && (
          <a href="/blog" class="sec-more">
            Read all {allPosts.length} notes <span aria-hidden="true">→</span>
          </a>
        )}
      </section>

      <!-- ── f0/4 · About (bio · skills · experience · certificates) ─ -->
      <section id="about" data-section data-iface="4" class="sec">
        <header class="sec-head">
          <p class="meta text-green">interface FastEthernet0/4</p>
          <h2 class="t-h2 mt-1.5 font-semibold">About</h2>
        </header>

        <div class="mt-6 max-w-[68ch] space-y-4 leading-relaxed text-fg">
          <p>
            My experience focuses on managing and supporting MikroTik RouterOS in a production
            environment to maintain reliable network connectivity and business operations. My
            responsibilities include LAN and wireless connectivity, NAT, DHCP, Firewall Filter,
            Quality of Service (QoS), and troubleshooting network issues.
          </p>
          <p>
            To strengthen my networking foundation, I'm continuously sharpening my Cisco
            networking skills through CCNA training and hands-on Packet Tracer labs covering
            VLAN, Inter-VLAN Routing, STP, EtherChannel, HSRP, Static Routing, NAT, and GRE
            Tunnel.
          </p>
          <p>
            I'm committed to continuous learning and preparing for opportunities in Network
            Engineering by combining production experience with hands-on Cisco networking
            practice.
          </p>
        </div>

        <!-- Skills -->
        <div id="skills" class="sub">
          <h3 class="t-h3 font-semibold">Skills</h3>
          <div class="mt-4 space-y-3">
            {skillGroups.map(({ label, items }) => (
              <div class="card p-4 sm:p-5">
                <p class="meta uppercase tracking-wide text-muted">{label}</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {items.map((name) => (
                    <span class="meta rounded-md border border-border bg-surface-2 px-2.5 py-1 text-fg">
                      {name}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Experience -->
        <div id="experience" class="sub">
          <h3 class="t-h3 font-semibold">Experience</h3>
          <div class="mt-4">
            <ExperienceList />
          </div>
        </div>

        <!-- Certificates -->
        <div id="certificates" class="sub">
          <h3 class="t-h3 font-semibold">Licenses &amp; certifications</h3>
          <div class="mt-4">
            <CertificateList />
          </div>
        </div>
      </section>

      <!-- ── f0/5 · Contact ─────────────────────────────────────── -->
      <section id="contact" data-section data-iface="5" class="sec">
        <header class="sec-head">
          <p class="meta text-green">interface FastEthernet0/5</p>
          <h2 class="t-h2 mt-1.5 font-semibold">Contact</h2>
          <p class="t-lead mt-3 text-muted">
            Open to network engineering roles and collaboration on lab work. Send a message,
            or reach me directly.
          </p>
        </header>

        <div class="contact-grid mt-8">
          <div class="space-y-6">
            <div>
              <p class="meta text-muted">EMAIL</p>
              <a
                href={`mailto:${contact.email}`}
                class="mt-1 block break-all text-sm font-medium text-accent hover:underline"
              >
                {contact.email}
              </a>
            </div>

            <div>
              <p class="meta text-muted">LOCATION</p>
              <p class="mt-1 text-sm text-fg">{contact.location}</p>
            </div>

            <div>
              <p class="meta text-muted">SOCIALS</p>
              <ul class="mt-1 space-y-1 text-sm">
                {socials.map((s) => (
                  <li>
                    <a
                      href={s.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-[2.25rem] items-center text-accent no-underline hover:underline"
                    >
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="min-w-0">
            <ContactForm />
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { initScrollSpy } from '../scripts/scroll-spy';

  let cleanup: (() => void) | undefined;

  function start(): void {
    cleanup = initScrollSpy({ activationRatio: 0.3 });
  }

  start();

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  .caret {
    margin-left: 1px;
    color: var(--color-green);
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
  }
</style>

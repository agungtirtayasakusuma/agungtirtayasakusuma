---
// src/components/Button.astro
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  download?: boolean;
  external?: boolean;
}
const { href, variant = 'primary', download = false, external = false } = Astro.props;

const base = 'inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm font-medium no-underline transition-colors';
const styles = {
  primary: 'bg-heading text-bg hover:bg-fg',
  ghost: 'border border-border bg-surface text-fg hover:border-muted/60 hover:bg-surface-2',
};
---

<a
  href={href}
  class:list={[base, styles[variant]]}
  {...(download ? { download: true } : {})}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
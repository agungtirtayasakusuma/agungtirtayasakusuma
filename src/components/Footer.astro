---
// src/components/Footer.astro
import { site, socials, getInterfaceLabel } from '../config';

const status = getInterfaceLabel(Astro.url.pathname);
---

<footer class="mt-auto">
  <div class="shell">
    <div class="flex flex-col gap-5 border-t border-border py-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm text-muted">© {new Date().getFullYear()} {site.author}</p>
        <p class="meta mt-1.5 text-muted/60">
          <span class="text-green">●</span> {status}
        </p>
      </div>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted no-underline transition-colors hover:text-accent"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

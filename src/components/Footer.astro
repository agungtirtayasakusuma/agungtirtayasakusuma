---
// src/components/Footer.astro
import { site, socials, getInterfaceIndex, statusLine } from '../config';

// SSR value: correct before the spy runs, and correct on deep pages
// where there are no [data-section] elements to track.
const iface = getInterfaceIndex(Astro.url.pathname);
const status = statusLine(iface);
---

<footer class="mt-auto">
  <div class="shell">
    <div class="flex flex-col gap-6 border-t border-border py-8 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <p class="text-sm text-muted">© {new Date().getFullYear()} {site.author}</p>

        <p class="meta mt-2 flex items-start gap-2 text-muted/70">
          <span class="if-led" aria-hidden="true"></span>
          {/* Updated live by scroll-spy. aria-live is deliberately absent —
              announcing every scroll change would be constant noise. */}
          <span data-iface-status data-iface={iface} class="break-words">{status}</span>
        </p>
      </div>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[2.25rem] items-center text-muted no-underline transition-colors hover:text-accent"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .if-led {
    margin-top: 0.35em;
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 9999px;
    background: var(--color-green);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-green) 16%, transparent);
    animation: led-pulse 2.4s ease-in-out infinite;
  }

  @keyframes led-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.45; }
  }

  @media (prefers-reduced-motion: reduce) {
    .if-led { animation: none; }
  }
</style>

---
// src/components/Logo.astro
import { site, getInterfaceIndex, getInterfaceLabel } from '../config';

interface Props {
  size?: 'sm' | 'md';
}
const { size = 'sm' } = Astro.props;

const iface = getInterfaceIndex(Astro.url.pathname);
const status = getInterfaceLabel(Astro.url.pathname);
---

<a
  href="/"
  title={status}
  aria-label={`${site.title} — home`}
  class:list={[
    'group inline-flex items-baseline font-mono font-semibold tabular-nums no-underline',
    size === 'md' ? 'text-base' : 'text-sm',
  ]}
>
  {/* Decorative to assistive tech: the digit changes on every scroll, and
      announcing that would be constant noise. The aria-label above is the label. */}
  <span aria-hidden="true" class="inline-flex items-baseline">
    <span class="text-heading">Porto</span><span class="text-green">f0/</span><span
      class="iface text-green"
      data-iface-digit>{iface}</span><span class="text-accent">.</span>
  </span>
</a>

<style>
  .iface {
    display: inline-block;
    min-width: 1ch;   /* no header reflow between digits */
    text-align: center;
    view-transition-name: iface-digit;
  }

  a:hover .iface {
    text-shadow: 0 0 10px color-mix(in oklab, var(--color-green) 55%, transparent);
  }
</style>

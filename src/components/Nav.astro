---
import { site, navLinks } from '../config';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-4xl items-center justify-between px-6">
    <a
      href="/"
      class="font-mono text-sm font-semibold text-heading no-underline"
   >
      Porto<span style="color: #3fb950;" class="font-mono">f0/1</span><span class="text-accent">.</span>
    </a>

    <ul class="flex items-center gap-1 text-sm">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-1.5 no-underline transition-colors',
              isActive(href)
                ? 'bg-surface text-heading'
                : 'text-muted hover:bg-surface hover:text-fg',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
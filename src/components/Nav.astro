---
// src/components/Nav.astro
import Logo from './Logo.astro';
import { sections, getActiveSectionId } from '../config';

const ssrActive = getActiveSectionId(Astro.url.pathname);
const isHome = Astro.url.pathname === '/';

// On the home page use a bare hash so no navigation is attempted.
// Everywhere else use an absolute path so the link works from a deep page.
function getSmartHref(id: string): string {
  if (id === 'home') return '/';
  return isHome ? `#${id}` : `/#${id}`;
}
---

<div id="nav-sentinel" aria-hidden="true"></div>

<header id="site-header" class="site-header">
  <nav class="shell flex h-[var(--nav-h)] items-center justify-between gap-4" aria-label="Primary">
    <Logo />

    <!-- Desktop -->
    <ul class="hidden items-center gap-0.5 text-sm md:flex">
      {sections.map(({ id, label }) => (
        <li>
          <a
            href={getSmartHref(id)}
            data-spy-link={id}
            data-active={id === ssrActive ? '' : undefined}
            aria-current={id === ssrActive ? 'page' : undefined}
            class="nav-link rounded-md px-3 py-1.5 text-muted no-underline transition-colors duration-150 hover:bg-surface hover:text-fg"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile trigger -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border bg-surface text-fg transition-colors hover:border-muted/60 md:hidden"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label="Open menu"
    >
      <svg class="icon-open h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="icon-close h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <div id="nav-panel" class="nav-panel md:hidden" hidden>
    <ul class="shell flex flex-col gap-0.5 py-3">
      {sections.map(({ id, label, iface }) => (
        <li>
          <a
            href={getSmartHref(id)}
            data-spy-link={id}
            data-active={id === ssrActive ? '' : undefined}
            aria-current={id === ssrActive ? 'page' : undefined}
            class="nav-mobile-link flex min-h-[2.75rem] items-center justify-between rounded-md px-3 py-3 text-sm text-muted no-underline transition-colors hover:bg-surface hover:text-fg"
          >
            <span>{label}</span>
            <span class="meta tabular-nums opacity-60">f0/{iface}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-bg) 82%, transparent);
    transition: box-shadow 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header { backdrop-filter: blur(10px) saturate(140%); }
  }
  @supports not (backdrop-filter: blur(8px)) {
    .site-header { background: var(--color-bg); }
  }

  .site-header[data-scrolled] {
    box-shadow: 0 1px 0 0 color-mix(in oklab, var(--color-border) 60%, transparent),
                0 8px 24px -12px rgb(0 0 0 / 0.65);
  }

  /* ── Icon state ────────────────────────────────────────────────
     Exactly one rule hides exactly one icon, and the two conditions
     are mutually exclusive by construction. There is no "default +
     override" pair, so no cascade race — and `:not([aria-expanded='true'])`
     also covers the attribute being missing or malformed, which the
     previous `[aria-expanded='false']` form did not. */
  #nav-toggle svg { display: block; }
  #nav-toggle:not([aria-expanded='true']) .icon-close { display: none; }
  #nav-toggle[aria-expanded='true'] .icon-open { display: none; }

  .nav-link { position: relative; }
  .nav-link[data-active] { color: var(--color-heading); }
  .nav-link[data-active]::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: -0.4rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-green);
  }

  .nav-mobile-link[data-active] {
    background: var(--color-surface);
    color: var(--color-heading);
  }
  .nav-mobile-link[data-active] .meta { color: var(--color-green); opacity: 1; }

  /* ── Panel ─────────────────────────────────────────────────────
     A dropdown, not a modal. The page behind stays scrollable on
     purpose; `overscroll-behavior: contain` stops the panel's own
     scroll from chaining to the document. No body lock anywhere. */
  .nav-panel {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  .nav-panel[hidden] { display: none; }

  #nav-sentinel { position: absolute; top: 0; height: 1px; width: 100%; }
</style>

<script>
  function initNav(): void {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('nav-panel');
    const sentinel = document.getElementById('nav-sentinel');

    if (!header || !toggle || !panel) return;
    if (header.dataset['navReady'] === 'true') return;
    header.dataset['navReady'] = 'true';

    // Defensive: clear any lock class left behind by an older build.
    document.documentElement.classList.remove('nav-open');

    // Every listener below is registered with this signal, so teardown is a
    // single abort() call. Without it, each client-side navigation stacked
    // another keydown and matchMedia listener pointing at detached nodes.
    const controller = new AbortController();
    const { signal } = controller;

    function setOpen(open: boolean): void {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.hidden = !open;
    }

    function isOpen(): boolean {
      return toggle !== null && toggle.getAttribute('aria-expanded') === 'true';
    }

    // Start from a known state — a client-side navigation can restore markup
    // mid-transition, and an inconsistent attribute is what made the icon
    // appear to vanish.
    setOpen(false);

    toggle.addEventListener('click', () => setOpen(!isOpen()), { signal });

    /**
     * Close in the CAPTURE phase.
     *
     * scroll-spy binds its own handler directly on each <a>, and that handler
     * calls preventDefault() then scrollIntoView(). Capture runs root -> target,
     * so this fires *before* the anchor's own listener. The panel is therefore
     * already collapsed — and the sticky header already back to its short
     * height — by the time scrollIntoView measures the destination.
     *
     * Closing afterwards (bubble phase) removed ~200px of header mid-animation
     * and shifted the target out from under the running scroll. That was the
     * "lags or gets stuck" symptom.
     */
    panel.addEventListener(
      'click',
      (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest('a')) setOpen(false);
      },
      { capture: true, signal }
    );

    // Tap outside the header closes the drawer.
    document.addEventListener(
      'pointerdown',
      (event) => {
        if (!isOpen()) return;
        const target = event.target;
        if (target instanceof Node && header !== null && !header.contains(target)) {
          setOpen(false);
        }
      },
      { signal }
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && isOpen()) {
          setOpen(false);
          toggle?.focus();
        }
      },
      { signal }
    );

    // Crossing into the desktop breakpoint must never leave a stuck overlay.
    const desktop = window.matchMedia('(min-width: 768px)');
    desktop.addEventListener(
      'change',
      (event) => {
        if (event.matches) setOpen(false);
      },
      { signal }
    );

    let observer: IntersectionObserver | undefined;
    if (sentinel) {
      observer = new IntersectionObserver(([entry]) => {
        if (entry && entry.isIntersecting) header.removeAttribute('data-scrolled');
        else header.setAttribute('data-scrolled', '');
      });
      observer.observe(sentinel);
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        controller.abort();
        observer?.disconnect();
        document.documentElement.classList.remove('nav-open');
        delete header.dataset['navReady'];
      },
      { once: true }
    );
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>

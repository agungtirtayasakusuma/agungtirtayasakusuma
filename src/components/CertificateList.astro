---
// src/components/CertificateList.astro
import { certificates } from '../data/certificates';

function logoFor(issuer: string): string {
  const key = issuer.toLowerCase();
  if (key.includes('id-networkers') || key.includes('idn')) return '/idn.jpg';
  if (key.includes('packt')) return '/packt.jpg';
  if (key.includes('google')) return '/google.jpg';
  return '';
}

const VISIBLE_SKILLS = 3;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  {certificates.map((cert, index) => {
    const logo = logoFor(cert.issuer);
    const skills = cert.skills ?? [];
    const shown = skills.slice(0, VISIBLE_SKILLS).join(', ');
    const rest = skills.slice(VISIBLE_SKILLS).join(', ');
    const hasMore = skills.length > VISIBLE_SKILLS;
    const panelId = `cert-skills-${index}`;
    const hasUrl = typeof cert.url === 'string' && cert.url.trim() !== '';

    return (
      <article class="card flex h-full flex-col p-4 sm:p-5">
        <header class="flex items-start gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-md border border-border bg-surface">
            {logo ? (
              <img
                src={logo}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            ) : (
              <span class="font-mono text-sm font-bold text-heading">
                {cert.issuer.charAt(0)}
              </span>
            )}
          </div>

          <div class="min-w-0">
            <h4 class="text-sm font-semibold leading-snug text-heading sm:text-base">
              {cert.name}
            </h4>
            <p class="mt-0.5 text-sm text-muted">{cert.issuer}</p>
          </div>
        </header>

        <div class="mt-4 space-y-1">
          <p class="meta text-muted">
            Issued {cert.issued}{cert.expires && <> · Expires {cert.expires}</>}
          </p>
          {cert.credentialId && (
            <p class="meta break-all text-muted">ID {cert.credentialId}</p>
          )}
        </div>

        {skills.length > 0 && (
          <div class="mt-4 border-t border-border/30 pt-3 text-xs leading-relaxed text-muted">
            <span class="font-semibold text-fg/90">Skills: </span>
            <span>{shown}</span>
            {hasMore && (
              <>
                <span> and </span>
                <button
                  type="button"
                  data-cert-toggle={panelId}
                  data-label-more={`+${skills.length - VISIBLE_SKILLS} more`}
                  data-label-less="show less"
                  aria-expanded="false"
                  aria-controls={panelId}
                  class="inline-flex min-h-[1.75rem] items-center font-medium text-accent underline-offset-2 hover:underline"
                >
                  +{skills.length - VISIBLE_SKILLS} more
                </button>
                <div id={panelId} hidden class="mt-1.5 text-muted/90">{rest}</div>
              </>
            )}
          </div>
        )}

        {hasUrl && (
          <div class="mt-auto border-t border-border pt-4">
            <a
              href={cert.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[2.25rem] items-center gap-1.5 rounded-md border border-border bg-surface px-3.5 py-1.5 text-xs font-medium text-fg no-underline transition-colors hover:border-accent hover:bg-surface-2"
            >
              Show credential <span class="text-accent" aria-hidden="true">↗</span>
            </a>
          </div>
        )}
      </article>
    );
  })}
</div>

<script>
  function initCertToggles(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-cert-toggle]');

    for (const btn of buttons) {
      if (btn.dataset['certBound'] === 'true') continue;
      btn.dataset['certBound'] = 'true';

      btn.addEventListener('click', () => {
        const panelId = btn.dataset['certToggle'];
        if (!panelId) return;

        const panel = document.getElementById(panelId);
        if (!panel) return;

        const willOpen = panel.hidden;
        panel.hidden = !willOpen;
        btn.setAttribute('aria-expanded', String(willOpen));
        btn.textContent = willOpen
          ? btn.dataset['labelLess'] ?? 'show less'
          : btn.dataset['labelMore'] ?? 'show more';
      });
    }
  }

  initCertToggles();
  // DOMContentLoaded does not fire on client-side navigations.
  document.addEventListener('astro:page-load', initCertToggles);
</script>
